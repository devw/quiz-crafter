# 🌍 Environment configuration for Quiz Crafter

# Path to your Google Cloud Service Account key (do NOT commit the real file)
GOOGLE_APPLICATION_CREDENTIALS=~/.config/quiz-crafter-key.json

# Optional: Google Cloud project ID
GOOGLE_CLOUD_PROJECT=quiz-crafter-477015

# Max number of quiz questions to import (default: 5)
MAX_QUESTIONS=5

# URL of the JSON file containing quiz data
QUIZ_JSON_URL=https://raw.githubusercontent.com/aphd/informatica-1/refs/heads/main/json/AI-Prompting.json

# Google Drive folder ID where forms will be created
GOOGLE_DRIVE_FOLDER_ID=1R2gG0ztLSSTEjDdTrjFFlTi_FThPUtaM
