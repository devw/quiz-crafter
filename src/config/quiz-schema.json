{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Quiz Schema",
    "description": "Schema for quiz configuration files",
    "type": "object",
    "required": ["title", "sections"],
    "properties": {
        "title": {
            "type": "string",
            "description": "The main title of the quiz/form",
            "minLength": 1,
            "maxLength": 200
        },
        "description": {
            "type": "string",
            "description": "Optional description of the quiz",
            "maxLength": 1000
        },
        "sections": {
            "type": "array",
            "description": "Array of quiz sections",
            "minItems": 1,
            "items": {
                "$ref": "#/definitions/section"
            }
        }
    },
    "definitions": {
        "section": {
            "type": "object",
            "required": ["title", "questions"],
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Section title",
                    "minLength": 1
                },
                "description": {
                    "type": "string",
                    "description": "Section description or instructions"
                },
                "questions": {
                    "type": "array",
                    "description": "Array of questions in this section",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/definitions/question"
                    }
                }
            }
        },
        "question": {
            "type": "object",
            "required": ["title", "question", "type", "options"],
            "properties": {
                "title": {
                    "type": "string",
                    "description": "Question identifier (e.g., 'Domanda 1.1')",
                    "minLength": 1
                },
                "question": {
                    "type": "string",
                    "description": "The actual question text",
                    "minLength": 1
                },
                "hint": {
                    "type": "string",
                    "description": "Optional hint for the question"
                },
                "type": {
                    "type": "string",
                    "enum": ["MULTIPLE_CHOICE", "CHECKBOX", "DROPDOWN"],
                    "description": "Question type"
                },
                "required": {
                    "type": "boolean",
                    "description": "Whether the question is required",
                    "default": true
                },
                "options": {
                    "type": "array",
                    "description": "Array of answer options",
                    "minItems": 2,
                    "items": {
                        "$ref": "#/definitions/option"
                    }
                },
                "feedback": {
                    "type": "string",
                    "description": "Explanation shown after answering"
                }
            }
        },
        "option": {
            "type": "object",
            "required": ["value", "label"],
            "properties": {
                "value": {
                    "type": "string",
                    "description": "The option value/text",
                    "minLength": 1
                },
                "label": {
                    "type": "string",
                    "description": "Option label (e.g., 'A', 'B', 'C')",
                    "minLength": 1
                },
                "isCorrect": {
                    "type": "boolean",
                    "description": "Whether this is the correct answer",
                    "default": false
                }
            }
        }
    }
}
